{
  "name": "genyx",
  "version": "0.4.0",
  "private": true,
  "description": "Genyx corporate platform — Sprint 3 commercial integration laboratory",
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-sqlite node_modules/vitest/vitest.mjs run",
    "test:watch": "node --experimental-sqlite node_modules/vitest/vitest.mjs",
    "test:content": "vitest run tests/unit/content-validation.test.ts",
    "test:coverage": "node --experimental-sqlite node_modules/vitest/vitest.mjs run --coverage",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:n8n": "node scripts/n8n-smoke.mjs",
    "test:crm": "node scripts/crm-smoke.mjs",
    "test:bridge": "node --experimental-strip-types --test tests/foundation/n8n-crm-bridge.test.mjs",
    "crm:sync": "node --experimental-sqlite --experimental-strip-types --disable-warning=ExperimentalWarning scripts/crm-sync.mjs",
    "crm": "node --experimental-sqlite --experimental-strip-types --disable-warning=ExperimentalWarning scripts/crm.mjs",
    "test:lighthouse": "node scripts/check-lighthouse.mjs",
    "architecture": "node scripts/check-architecture.mjs && node scripts/check-public-boundary.mjs",
    "test:boundary": "node --test tests/foundation/public-boundary.test.mjs",
    "test:foundation": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/foundation/locale.test.mjs",
    "check": "npm run architecture && npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run build",
    "audit:security": "npm audit --audit-level=high"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~5.9.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.6.0",
    "vitest": "^4.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/postcss": "^4.1.0",
    "postcss": "^8.5.0"
  },
  "type": "module"
}
