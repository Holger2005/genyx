{
  "name": "genyx",
  "version": "0.1.0",
  "private": true,
  "description": "Genyx corporate platform \u2014 Sprint 0",
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "architecture": "node scripts/check-architecture.mjs",
    "test:foundation": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test tests/foundation/locale.test.mjs",
    "check": "npm run architecture && npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run build",
    "audit:security": "npm audit --audit-level=high"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~5.9.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.6.0",
    "vitest": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/postcss": "^4.1.0",
    "postcss": "^8.5.0"
  },
  "type": "module"
}
